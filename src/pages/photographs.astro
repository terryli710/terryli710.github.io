---
// photographs.astro — PHOTOGRAPHS · 摄影.
//
// Two ways through the same 16 photographs: ROW (centre one at full height,
// neighbours only half in view, scroll-snapped) and COLUMN (one per band,
// nothing cropped) — both render server-side, a client script toggles which one
// is visible. Clicking (or Enter-ing) the centre one opens the shared
// full-screen lightbox (src/scripts/lightbox.ts), which the home page uses too.
//
// Each photograph is captioned with its camera number, where it was made, and
// its position in the set. Nothing else: there are no rolls, no film stock and
// no invented one-line notes, because none of that is true of these files.
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import T from "../components/T.astro";
import { reel, gcount } from "../data/frames";
import { ui, t } from "../config/i18n";
import { srcset, SIZES } from "../utils/img";
import { dims } from "../utils/dims";

const num = (i: number) => `${String(i + 1).padStart(2, "0")} / ${reel.length}`;
const first = reel[0];

// Every frame's intrinsic size, so a lazy frame reserves its final width before
// its bytes arrive. Without this the reel measured 3531px on load and 8543px
// once loaded — every snap point moving under the reader mid-scroll. See
// src/utils/dims.ts.
const size = reel.map((f) => dims(f.src));
---

<BaseLayout title={t("Photographs · Yiheng Li", "摄影 · 李易恒")}>
  <main>
    <section class="dk-head">
      <p class="dk-kicker"><T t={ui.photographs.kicker} /></p>
      <div class="dk-headr">
        <div class="dk-count">
          <div><T t={gcount} /></div>
          <div><T t={ui.photographs.camera} /></div>
        </div>
        <div class="dk-views">
          <button type="button" data-view-btn="reel" aria-pressed="true">
            <T t={ui.photographs.viewRow} />
          </button>
          <button type="button" data-view-btn="scroll" aria-pressed="false">
            <T t={ui.photographs.viewColumn} />
          </button>
        </div>
      </div>
    </section>

    <!-- ROW — centre photograph at full size, neighbours only half in view -->
    <section class="dk-reel-wrap" data-view-panel="reel">
      <div class="dk-reel" data-reel>
        {
          reel.map((f, i) => (
            <figure
              data-reel-item
              data-index={i}
              data-frame-no={f.frame}
              data-place-en={f.place.en}
              data-place-zh={f.place.zh}
            >
              <img
                data-frame
                data-view="reel"
                data-index={i}
                src={f.src}
                srcset={srcset(f.src)}
                sizes={SIZES.reel}
                width={size[i]?.width}
                height={size[i]?.height}
                alt=""
                loading={i < 3 ? "eager" : "lazy"}
              />
            </figure>
          ))
        }
      </div>
      <div class="dk-bar">
        <span class="frame" data-bar="frame">{first.frame}</span>
        <span class="exif" data-bar="place"><T t={first.place} /></span>
        <span class="line"></span>
        <span class="nav">
          <button
            type="button"
            data-step="-1"
            data-t-aria-label-en={ui.photographs.prevFrame.en}
            data-t-aria-label-zh={ui.photographs.prevFrame.zh}
            aria-label={ui.photographs.prevFrame.en}>←</button
          >
          <span class="n" data-bar="n">{num(0)}</span>
          <button
            type="button"
            data-step="1"
            data-t-aria-label-en={ui.photographs.nextFrame.en}
            data-t-aria-label-zh={ui.photographs.nextFrame.zh}
            aria-label={ui.photographs.nextFrame.en}>→</button
          >
        </span>
      </div>
    </section>

    <!-- COLUMN — one photograph per band, nothing cropped -->
    <section class="dk-col" data-view-panel="scroll" hidden>
      {
        reel.map((f, i) => (
          <figure>
            <div class="plate">
              <img
                data-frame
                data-view="scroll"
                data-index={i}
                src={f.src}
                srcset={srcset(f.src)}
                sizes={SIZES.column}
                width={size[i]?.width}
                height={size[i]?.height}
                alt=""
                loading="lazy"
              />
            </div>
            <figcaption>
              <span class="l">
                <span class="frame">{f.frame}</span>
                <span class="exif">
                  <T t={f.place} />
                </span>
              </span>
              <span>{num(i)}</span>
            </figcaption>
          </figure>
        ))
      }
    </section>
  </main>

  <Lightbox />
</BaseLayout>

<script>
  // ══ Darkroom: reel + scroll ══
  //
  // Both views are already in the DOM (server-rendered); only visibility
  // toggles client-side. Layout never changes while scrolling the reel:
  // distance-from-centre drives each frame's opacity/scale/saturation
  // imperatively, and the status bar underneath is repainted from the frame
  // nearest the centre.
  //
  // Zooming a frame is not this page's job — src/scripts/lightbox.ts owns it,
  // and `onFrameChange` keeps this page's idea of "the current frame" in step
  // while the reader steps through the reel full screen.
  import { openLightbox, closeLightbox, isOpen, onFrameChange } from "../scripts/lightbox";
  import { bi } from "../scripts/bilingual";

  const reelEl = document.querySelector<HTMLElement>("[data-reel]");
  const reelPanel = document.querySelector<HTMLElement>('[data-view-panel="reel"]');
  const scrollPanel = document.querySelector<HTMLElement>('[data-view-panel="scroll"]');
  const viewButtons = document.querySelectorAll<HTMLButtonElement>("[data-view-btn]");
  const reelLen = reelPanel?.querySelectorAll("[data-reel-item]").length ?? 0;

  const bar = document.querySelector<HTMLElement>(".dk-bar");
  const barFrame = bar?.querySelector<HTMLElement>('[data-bar="frame"]');
  const barPlace = bar?.querySelector<HTMLElement>('[data-bar="place"]');
  const barN = bar?.querySelector<HTMLElement>('[data-bar="n"]');

  let view: "reel" | "scroll" = "reel";
  let gi = 0; // index nearest the reel's centre / last frame interacted with

  function num(i: number) {
    return String(i + 1).padStart(2, "0") + " / " + reelLen;
  }

  // The bar is repainted as the row moves. The place is bilingual, so both
  // languages go in as `.le`/`.lz` spans and CSS keeps choosing; the camera
  // number and the position are the same in either language.
  function paintBar() {
    const fig = reelItems()[gi];
    if (!fig) return;
    if (barFrame) barFrame.textContent = fig.dataset.frameNo ?? "";
    if (barPlace) barPlace.innerHTML = bi(fig.dataset.placeEn, fig.dataset.placeZh);
    if (barN) barN.textContent = num(gi);
  }

  // ── reel ─────────────────────────────────────────────────────────────
  /** The reel is server-rendered and never re-built, so this is worth caching —
   *  it is read several times per wheel event. */
  let items: HTMLElement[] | null = null;
  function reelItems(): HTMLElement[] {
    if (!items && reelEl) {
      items = Array.from(reelEl.querySelectorAll<HTMLElement>("[data-reel-item]"));
    }
    return items ?? [];
  }

  // Wheel → the reel, one to one, with snap disarmed while the hand is on it.
  //
  // The wheel is not a stepper. It moves `scrollLeft` by whatever the reader
  // turned, so the reel tracks the hand continuously and reverses the instant
  // the hand reverses. When the wheel goes quiet the reel lands on the frame
  // nearest the centre, and only then is snap re-armed — on a snap point, where
  // re-arming cannot move anything.
  //
  // Snap has to come off for the duration, and this is not optional: on a
  // `scroll-snap-type: x mandatory` container the browser re-snaps *programmatic*
  // writes immediately, so a write smaller than half the gap between frames is
  // swallowed whole. Measured on this reel, with snap armed: a 12-unit trackpad
  // event asks for 14px and moves 0, a 100-unit mouse notch asks for 115px and
  // moves 0, and only past ~170 units does anything happen — a full 328px frame
  // at once. Driving `scrollLeft` against armed snap is therefore dead for
  // trackpads and quantised for mice, which is why snap comes off first.
  //
  // What this replaces: a discrete stepper that banked delta up to a threshold,
  // moved one frame, and then ignored the wheel for 320ms while the landing
  // played. A trackpad flick is 30–60 events over about that long, so all but
  // the first were dropped — the reel refusing the hand mid-flick. Backwards was
  // worse: reversing also discarded the banked delta, and the same 320ms gated
  // `paintReel` from updating the current frame, so the bar froze too.
  const slow = window.matchMedia("(prefers-reduced-motion: reduce)");

  /** How long a smooth landing owns the reel — see `goTo`. */
  const STEP_HOLD = 320;
  /** Wheel silence that counts as the end of a gesture, momentum included. */
  const SETTLE = 140;

  /** While `performance.now()` is under this, a `goTo` landing is still in flight. */
  let held = 0;
  /** The wheel currently owns the reel, and snap is off for the duration. */
  let driving = false;
  let settleT = 0;

  /**
   * Where the reel comes to rest on its first and last frames.
   *
   * Not `0` and `scrollWidth - clientWidth`: the reel is padded by 44vw at each
   * end so an outer frame can still reach the centre, and that padding leaves a
   * band of travel at each end which snap will never rest in. Measured at a
   * 1440px viewport, the first frame rests at 329 and the last at 8661 against a
   * maximum of 8990 — 329px of dead travel at either end. An escape hatch tested
   * against the raw bounds therefore never opens, and the reader wheels against a
   * reel that will not move and a page that will not scroll. These are the snap
   * positions themselves, so the test is exact at any width.
   *
   * Cached: four `getBoundingClientRect()` reads per wheel event is not free,
   * and the answer only changes when the reel is re-laid-out.
   */
  let bounds: [number, number] | null = null;
  function travel(): [number, number] {
    if (!bounds) bounds = [centerOffset(0) ?? 0, centerOffset(reelLen - 1) ?? 0];
    return bounds;
  }

  function bindReel() {
    if (!reelEl) return;
    const el = reelEl;

    let raf = 0;
    el.addEventListener(
      "scroll",
      () => {
        if (raf) return;
        raf = requestAnimationFrame(() => {
          raf = 0;
          paintReel();
        });
      },
      { passive: true },
    );

    el.addEventListener(
      "wheel",
      (e) => {
        // A genuine horizontal trackpad swipe scrolls the reel natively, and
        // mandatory snap catches it at the end. Nothing to do.
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;

        // Off either end the wheel belongs to the page again — the reel is 58vh
        // and there is a bar and a footer below it, so the reader has to be able
        // to leave.
        const [lo, hi] = travel();
        const back = e.deltaY < 0;
        if ((back && el.scrollLeft <= lo + 1) || (!back && el.scrollLeft >= hi - 1)) return;

        e.preventDefault();
        // The hand takes the reel off any smooth landing still in flight. Writing
        // `scrollLeft` cancels the landing, so `held` has to go with it — left
        // standing it would keep `paintReel` from adopting the frame the reader
        // is actually turning towards, and freeze the bar on the abandoned one.
        held = 0;
        if (!driving) {
          driving = true;
          el.style.scrollSnapType = "none";
        }
        // Clamped to the outer frames' own snap positions, so overshooting never
        // exposes the 44vw of empty padding beyond them.
        el.scrollLeft = Math.max(lo, Math.min(hi, el.scrollLeft + e.deltaY * 1.15));

        clearTimeout(settleT);
        settleT = window.setTimeout(land, SETTLE);
      },
      { passive: false },
    );
  }

  /**
   * The wheel has gone quiet. Glide to the frame nearest the centre — `gi` has
   * been tracking it live, because nothing gates `paintReel` while `held` is 0 —
   * and re-arm snap once that glide has arrived. Re-arming only ever happens on
   * a snap point, so it is silent; re-arming mid-reel would jump the reel out
   * from under the reader instead.
   */
  function land() {
    driving = false;
    goTo(gi);
    window.setTimeout(() => {
      if (!driving && reelEl) reelEl.style.scrollSnapType = "";
    }, STEP_HOLD);
  }

  // A re-layout moves the snap positions, so the cached travel has to go.
  window.addEventListener("resize", () => {
    bounds = null;
  });

  /** Last distance-from-centre written per frame, so a still reel writes nothing. */
  const painted = new WeakMap<HTMLElement, string>();

  function paintReel() {
    if (!reelEl) return;
    const kids = reelItems();
    if (!kids.length) return;
    const dim = 0.62; // side frames recede — design default
    const rect = reelEl.getBoundingClientRect();
    const mid = rect.left + reelEl.clientWidth / 2;
    const span = reelEl.clientWidth * 0.42;

    // Measure all sixteen first, then write. Interleaving reads and writes asks
    // the browser to settle styles between every frame of a scroll.
    const ds = kids.map((k) => {
      const r = k.getBoundingClientRect();
      return Math.min(1, Math.abs(r.left + r.width / 2 - mid) / span);
    });

    let best = 0;
    let bestD = Infinity;
    ds.forEach((d, i) => {
      if (d < bestD) {
        bestD = d;
        best = i;
      }
    });

    kids.forEach((k, i) => {
      const d = ds[i];
      const key = d.toFixed(3);
      if (painted.get(k) === key) return; // this frame has not moved
      painted.set(k, key);
      k.style.opacity = (1 - dim * d).toFixed(3);
      k.style.transform = `scale(${(1 - 0.13 * d).toFixed(3)})`;
      k.style.filter = d < 0.05 ? "none" : `saturate(${(1 - 0.45 * d).toFixed(2)})`;
      k.style.cursor = d < 0.05 ? "zoom-in" : "pointer";
    });

    // While a step is still landing, the frame nearest the centre is whatever
    // the smooth scroll happens to be passing over. Adopting it would walk `gi`
    // backwards through every frame in flight and flicker the bar with it, so
    // the destination holds until it arrives.
    if (best !== gi && performance.now() >= held) {
      gi = best;
      paintBar();
    }
  }

  /**
   * Where the reel has to sit for frame `i` to be dead centre, clamped to the
   * travel that actually exists.
   *
   * Measured centre-to-centre deliberately. `paintReel` scales the side frames,
   * so `getBoundingClientRect()` reports the *scaled* box while `offsetWidth`
   * reports the unscaled one; mixing the two (as this did) put every landing up
   * to 43px off centre, and the snap engine then yanked it back — the lurch on
   * the way back through the reel. A scale about the centre leaves the centre
   * exactly where it was, so centres are the one transform-proof thing to read.
   */
  function centerOffset(i: number): number | null {
    const k = reelItems()[i];
    if (!reelEl || !k) return null;
    const kr = k.getBoundingClientRect();
    const rr = reelEl.getBoundingClientRect();
    const left = reelEl.scrollLeft + (kr.left + kr.width / 2 - rr.left) - reelEl.clientWidth / 2;
    return Math.max(0, Math.min(reelEl.scrollWidth - reelEl.clientWidth, left));
  }

  // `behavior: "smooth"` wins over the CSS `scroll-behavior: auto !important`
  // that the reduced-motion block sets, so the preference is checked here too.
  function centerTo(i: number, smooth = true) {
    const left = centerOffset(i);
    if (reelEl && left !== null) {
      reelEl.scrollTo({ left, behavior: smooth && !slow.matches ? "smooth" : "auto" });
    }
  }

  /**
   * Centre frame `i` and hold it as the current frame until the scroll lands.
   * Every way of moving the reel — wheel, arrows, buttons, clicking a side
   * frame, the lightbox — goes through here, so they cannot disagree.
   */
  function goTo(i: number, smooth = true) {
    gi = i;
    held = performance.now() + (smooth && !slow.matches ? STEP_HOLD : 0);
    paintBar();
    centerTo(i, smooth);
  }

  // Clicking the centre frame opens the lightbox; a side frame centres it
  // instead. In the scroll view every click opens the lightbox directly.
  function frameClick(i: number, el: HTMLElement, e: Event) {
    e.preventDefault();
    if (view === "scroll" || i === gi) return openLightbox(i, el);
    goTo(i);
  }

  /** Move the reel by ±1, wrapping. The lightbox does its own stepping when open. */
  function step(d: number, e?: Event) {
    if (e) {
      e.preventDefault?.();
      e.stopPropagation?.();
    }
    const n = reelLen;
    goTo((Math.min(gi, n - 1) + d + n) % n);
  }

  // Stepping inside the lightbox moves this page's current frame with it, so
  // closing it leaves the reel centred on whatever was last looked at.
  onFrameChange((i) => goTo(i, false));

  window.addEventListener("keydown", (e) => {
    if (isOpen()) return; // the lightbox owns the keyboard while it is up
    if (e.key === "ArrowRight") return step(1, e);
    if (e.key === "ArrowLeft") return step(-1, e);
    if (e.key === "Enter") {
      e.preventDefault();
      openLightbox(gi, null);
    }
  });

  // ── view toggle ──────────────────────────────────────────────────────
  function setView(next: "reel" | "scroll") {
    if (view === next) return;
    view = next;
    closeLightbox();
    if (reelPanel) reelPanel.hidden = next !== "reel";
    if (scrollPanel) scrollPanel.hidden = next !== "scroll";
    viewButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.viewBtn === next)));
    window.scrollTo(0, 0);
    // A hidden panel measures nothing, so anything cached off the reel's layout
    // is stale the moment it comes back. A gesture in flight goes with it —
    // otherwise the reel comes back with snap still disarmed.
    bounds = null;
    clearTimeout(settleT);
    driving = false;
    if (reelEl) reelEl.style.scrollSnapType = "";
    requestAnimationFrame(() => {
      centerTo(gi, false);
      paintReel();
    });
  }

  viewButtons.forEach((b) => {
    b.addEventListener("click", () => setView(b.dataset.viewBtn === "scroll" ? "scroll" : "reel"));
  });

  reelEl?.addEventListener("click", (e) => {
    const fig = (e.target as HTMLElement).closest<HTMLElement>("[data-reel-item]");
    if (!fig) return;
    const i = Number(fig.dataset.index);
    const img = fig.querySelector<HTMLElement>("img");
    frameClick(i, img ?? fig, e);
  });

  scrollPanel?.addEventListener("click", (e) => {
    const img = (e.target as HTMLElement).closest<HTMLElement>("img[data-frame]");
    if (!img) return;
    const i = Number(img.dataset.index);
    frameClick(i, img, e);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((btn) => {
    btn.addEventListener("click", (e) => step(Number(btn.dataset.step), e));
  });

  bindReel();
  requestAnimationFrame(() => {
    centerTo(gi, false);
    paintReel();
    paintBar();
  });
</script>
