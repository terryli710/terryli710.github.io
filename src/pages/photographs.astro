---
// photographs.astro — PHOTOGRAPHS · 摄影.
//
// One row of photographs: the centre one at full height, its neighbours only
// half in view. Wheel or arrow through it; clicking (or Enter-ing) the centre
// one opens the full-screen lightbox (src/scripts/lightbox.ts).
//
// Each photograph is captioned with its camera number, where it was made, and
// its position in the set. Nothing else: there are no rolls, no film stock and
// no invented one-line notes, because none of that is true of these files.
import BaseLayout from "../layouts/BaseLayout.astro";
import Lightbox from "../components/Lightbox.astro";
import T from "../components/T.astro";
import { reel, gcount } from "../data/frames";
import { ui, t } from "../config/i18n";
import { srcset, SIZES } from "../utils/img";
import { dims } from "../utils/dims";

const num = (i: number) => `${String(i + 1).padStart(2, "0")} / ${reel.length}`;
const first = reel[0];

// Every frame's intrinsic size, so a lazy frame reserves its final width before
// its bytes arrive. Without this the row measured 3531px on load and 8543px
// once loaded — every resting position moving under the reader mid-scroll. See
// src/utils/dims.ts.
const size = reel.map((f) => dims(f.src));
---

<BaseLayout title={t("Photographs · Yiheng Li", "摄影 · 李易恒")}>
  <main>
    <section class="dk-head">
      <p class="dk-kicker"><T t={ui.photographs.kicker} /></p>
      <div class="dk-count">
        <div><T t={gcount} /></div>
        <div><T t={ui.photographs.camera} /></div>
      </div>
    </section>

    <section class="dk-reel-wrap">
      <div class="dk-reel" data-reel>
        {
          reel.map((f, i) => (
            <figure
              data-reel-item
              data-index={i}
              data-frame-no={f.frame}
              data-place-en={f.place.en}
              data-place-zh={f.place.zh}
            >
              <img
                data-frame
                data-index={i}
                src={f.src}
                srcset={srcset(f.src)}
                sizes={SIZES.reel}
                width={size[i]?.width}
                height={size[i]?.height}
                alt=""
                loading={i < 3 ? "eager" : "lazy"}
              />
            </figure>
          ))
        }
      </div>
      {/* Runs during parse, before the first paint, so the row is held back
          until the module script below has centred frame 01. See .dk-reel
          [data-hold] in global.css. The timeout fails open: if that module is
          blocked or throws, an uncentred row beats an invisible one. */}
      <script is:inline>
        (function () {
          var r = document.querySelector("[data-reel]");
          if (!r) return;
          r.dataset.hold = "";
          setTimeout(function () {
            r.removeAttribute("data-hold");
          }, 1500);
        })();
      </script>
      <div class="dk-bar">
        <span class="frame" data-bar="frame">{first.frame}</span>
        <span class="exif" data-bar="place"><T t={first.place} /></span>
        <span class="line"></span>
        <span class="nav">
          <button
            type="button"
            data-step="-1"
            data-t-aria-label-en={ui.photographs.prevFrame.en}
            data-t-aria-label-zh={ui.photographs.prevFrame.zh}
            aria-label={ui.photographs.prevFrame.en}>←</button
          >
          <span class="n" data-bar="n">{num(0)}</span>
          <button
            type="button"
            data-step="1"
            data-t-aria-label-en={ui.photographs.nextFrame.en}
            data-t-aria-label-zh={ui.photographs.nextFrame.zh}
            aria-label={ui.photographs.nextFrame.en}>→</button
          >
        </span>
      </div>
    </section>
  </main>

  <Lightbox />
</BaseLayout>

<script>
  // ══ Photographs — the row ══
  //
  // This script owns the row's horizontal position outright. There is no CSS
  // scroll-snap on the container, deliberately.
  //
  // Why: a vertical wheel does not scroll a horizontal container natively, so
  // deltaY has to be turned into a `scrollLeft` write by hand — and on a
  // `scroll-snap-type: x mandatory` container the browser re-snaps programmatic
  // writes immediately, swallowing any write smaller than half the gap between
  // frames. Measured on this row with snap armed: a 12-unit trackpad event asked
  // for 14px and moved 0, a 100-unit mouse notch asked for 115px and moved 0,
  // and only past ~170 units did anything happen — a whole 328px frame at once.
  //
  // So snap had to come off for the duration of a gesture and go back on after,
  // and *that* is where scrolling backwards kept breaking. Two faults, both in
  // the re-arming:
  //
  //   1. Every landing scheduled an un-tracked `setTimeout` to re-arm snap and
  //      nothing ever cancelled it. Interrupting a landing — which is exactly
  //      what reversing does — left the old timer pending, and it re-armed
  //      mandatory snap while the *new* landing was still in the air, so the
  //      browser yanked the row to whatever snap point was nearest.
  //   2. Even alone, the re-arm fired on a fixed 320ms guess while the landing
  //      was a `scrollTo({behavior:"smooth"})` whose duration the browser picks
  //      from the distance and never reports. Reversing produces the long
  //      landings, so the guess expired mid-glide there first.
  //
  // Owning the position removes the whole class. Nothing can move the row except
  // `glideTo` and the wheel handler; the wheel handler cancels any glide before
  // it writes; and the landing is a rAF tween this file starts, can cancel on
  // the next event, and knows the end of. Forwards and backwards are the same
  // code path with the sign flipped.
  //
  // Zooming a frame is not this page's job — src/scripts/lightbox.ts owns it,
  // and `onFrameChange` keeps this page's idea of "the current frame" in step
  // while the reader steps through the set full screen.
  import { openLightbox, isOpen, onFrameChange } from "../scripts/lightbox";
  import { bi } from "../scripts/bilingual";

  const reelEl = document.querySelector<HTMLElement>("[data-reel]");
  const reelLen = document.querySelectorAll("[data-reel-item]").length;

  const bar = document.querySelector<HTMLElement>(".dk-bar");
  const barFrame = bar?.querySelector<HTMLElement>('[data-bar="frame"]');
  const barPlace = bar?.querySelector<HTMLElement>('[data-bar="place"]');
  const barN = bar?.querySelector<HTMLElement>('[data-bar="n"]');

  const slow = window.matchMedia("(prefers-reduced-motion: reduce)");

  /** How long a landing takes. */
  const GLIDE = 340;
  /** Scroll silence that counts as the end of a gesture, momentum included. */
  const SETTLE = 140;

  /** The frame at the centre — or the one a landing is on its way to. */
  let gi = 0;
  /** The reader has moved the row themselves, so nothing may re-centre it. */
  let touched = false;

  function num(i: number) {
    return String(i + 1).padStart(2, "0") + " / " + reelLen;
  }

  /** The row is server-rendered and never rebuilt, so this is worth caching. */
  let items: HTMLElement[] | null = null;
  function reelItems(): HTMLElement[] {
    if (!items && reelEl) {
      items = Array.from(reelEl.querySelectorAll<HTMLElement>("[data-reel-item]"));
    }
    return items ?? [];
  }

  // The bar is repainted as the row moves. The place is bilingual, so both
  // languages go in as `.le`/`.lz` spans and CSS keeps choosing; the camera
  // number and the position are the same in either language.
  function paintBar() {
    const fig = reelItems()[gi];
    if (!fig) return;
    if (barFrame) barFrame.textContent = fig.dataset.frameNo ?? "";
    if (barPlace) barPlace.innerHTML = bi(fig.dataset.placeEn, fig.dataset.placeZh);
    if (barN) barN.textContent = num(gi);
  }

  /**
   * Where the row has to sit for frame `i` to be dead centre, clamped to the
   * travel that actually exists.
   *
   * Measured centre-to-centre deliberately. `paintReel` scales the side frames,
   * so `getBoundingClientRect()` reports the *scaled* box while `offsetWidth`
   * reports the unscaled one; mixing the two put every landing up to 43px off
   * centre. A scale about the centre leaves the centre exactly where it was, so
   * centres are the one transform-proof thing to read.
   */
  function centerOffset(i: number): number | null {
    const k = reelItems()[i];
    if (!reelEl || !k) return null;
    const kr = k.getBoundingClientRect();
    const rr = reelEl.getBoundingClientRect();
    const left = reelEl.scrollLeft + (kr.left + kr.width / 2 - rr.left) - reelEl.clientWidth / 2;
    return Math.max(0, Math.min(reelEl.scrollWidth - reelEl.clientWidth, left));
  }

  /**
   * Where the row comes to rest on its first and last frames.
   *
   * Not `0` and `scrollWidth - clientWidth`: the row is padded by 44vw at each
   * end so an outer frame can still reach the centre, and that padding leaves a
   * band of travel at each end that no frame ever rests in. Measured at a 1280px
   * viewport, the first frame rests at 256 and the last at 7007 against a
   * maximum of 7263 — 256px of dead travel at either end. The escape hatch below
   * has to be tested against these, not the raw bounds, or it never opens and
   * the reader wheels against a row that will not move and a page that will not
   * scroll.
   *
   * Cached: four `getBoundingClientRect()` reads per wheel event is not free.
   */
  let bounds: [number, number] | null = null;
  function travel(): [number, number] {
    if (!bounds) bounds = [centerOffset(0) ?? 0, centerOffset(reelLen - 1) ?? 0];
    return bounds;
  }
  /** A re-layout moves the resting positions, so the cached travel has to go. */
  const remeasure = () => {
    bounds = null;
  };

  // ── landing ──────────────────────────────────────────────────────────
  /** rAF id of the landing in flight; 0 when the row is not moving itself. */
  let anim = 0;
  /** Where that landing is going; -1 when idle. */
  let animTo = -1;

  function cancelGlide() {
    if (anim) cancelAnimationFrame(anim);
    anim = 0;
    animTo = -1;
  }

  const ease = (p: number) => 1 - Math.pow(1 - p, 3);

  /** Land on frame `i`, cancelling whatever landing was already in the air. */
  function glideTo(i: number, smooth = true) {
    cancelGlide();
    if (!reelEl) return;
    const to = centerOffset(i);
    if (to === null) return;
    if (gi !== i) {
      gi = i;
      paintBar();
    }
    const from = reelEl.scrollLeft;
    const d = to - from;
    if (!smooth || slow.matches || Math.abs(d) < 0.5) {
      reelEl.scrollLeft = to;
      return;
    }
    animTo = i;
    const t0 = performance.now();
    const tick = (now: number) => {
      const p = Math.min(1, (now - t0) / GLIDE);
      reelEl.scrollLeft = from + d * ease(p);
      if (p < 1) {
        anim = requestAnimationFrame(tick);
        return;
      }
      anim = 0;
      animTo = -1;
    };
    anim = requestAnimationFrame(tick);
  }

  // ── painting ─────────────────────────────────────────────────────────
  /** Last distance-from-centre written per frame, so a still row writes nothing. */
  const painted = new WeakMap<HTMLElement, string>();
  /** Index nearest the middle as of the last paint. */
  let centred = 0;

  function paintReel() {
    if (!reelEl) return;
    const kids = reelItems();
    if (!kids.length) return;
    const dim = 0.62; // side frames recede — design default
    const rect = reelEl.getBoundingClientRect();
    const mid = rect.left + reelEl.clientWidth / 2;
    const span = reelEl.clientWidth * 0.42;

    // Measure all of them first, then write. Interleaving reads and writes asks
    // the browser to settle styles between every frame of a scroll.
    const ds = kids.map((k) => {
      const r = k.getBoundingClientRect();
      return Math.min(1, Math.abs(r.left + r.width / 2 - mid) / span);
    });

    let best = 0;
    let bestD = Infinity;
    ds.forEach((d, i) => {
      if (d < bestD) {
        bestD = d;
        best = i;
      }
    });
    centred = best;

    kids.forEach((k, i) => {
      const d = ds[i];
      const key = d.toFixed(3);
      if (painted.get(k) === key) return; // this frame has not moved
      painted.set(k, key);
      k.style.opacity = (1 - dim * d).toFixed(3);
      k.style.transform = `scale(${(1 - 0.13 * d).toFixed(3)})`;
      k.style.filter = d < 0.05 ? "none" : `saturate(${(1 - 0.45 * d).toFixed(2)})`;
      k.style.cursor = d < 0.05 ? "zoom-in" : "pointer";
    });

    // The bar follows the middle of the row, except while a landing is in the
    // air — then it shows where that landing is going, so it does not tick
    // through every frame the row passes over on the way. No timer gates this,
    // which is why the bar can no longer freeze on an abandoned frame.
    const cur = animTo >= 0 ? animTo : best;
    if (cur !== gi) {
      gi = cur;
      paintBar();
    }
  }

  // ── input ────────────────────────────────────────────────────────────
  let raf = 0;
  let settleT = 0;

  function scheduleSettle() {
    clearTimeout(settleT);
    settleT = window.setTimeout(() => glideTo(centred), SETTLE);
  }

  function bindReel() {
    if (!reelEl) return;
    const el = reelEl;

    el.addEventListener(
      "scroll",
      () => {
        if (!raf) {
          raf = requestAnimationFrame(() => {
            raf = 0;
            paintReel();
          });
        }
        // A landing lands itself. Anything else that moved the row — a
        // horizontal trackpad swipe, a scrollbar drag — settles onto the
        // nearest frame once it goes quiet, exactly as the wheel does.
        if (!anim) scheduleSettle();
      },
      { passive: true },
    );

    // Wheel → the row, one to one.
    //
    // The wheel is not a stepper. It moves `scrollLeft` by whatever the reader
    // turned, so the row tracks the hand continuously and reverses the instant
    // the hand reverses. When the wheel goes quiet the row lands on the frame
    // nearest the centre.
    //
    // What this replaces: a discrete stepper that banked delta up to a
    // threshold, moved one frame, then ignored the wheel for 320ms while the
    // landing played. A trackpad flick is 30–60 events over about that long, so
    // all but the first were dropped. Backwards was worse — reversing also
    // discarded the banked delta.
    el.addEventListener(
      "wheel",
      (e) => {
        touched = true;
        // A genuine horizontal trackpad swipe scrolls the row natively; the
        // scroll listener above settles it.
        if (Math.abs(e.deltaY) <= Math.abs(e.deltaX)) return;

        // Off either end the wheel belongs to the page again — the row is 58vh
        // and there is a bar and a footer below it, so the reader has to be
        // able to leave.
        const [lo, hi] = travel();
        const back = e.deltaY < 0;
        if ((back && el.scrollLeft <= lo + 1) || (!back && el.scrollLeft >= hi - 1)) return;

        e.preventDefault();
        // The hand takes the row off any landing still in the air. This is the
        // only way a landing is ever interrupted, and it happens before the
        // write, so the two can never disagree about where the row is.
        cancelGlide();
        // Clamped to the outer frames' own resting positions, so overshooting
        // never exposes the 44vw of empty padding beyond them.
        el.scrollLeft = Math.max(lo, Math.min(hi, el.scrollLeft + e.deltaY * 1.15));
        scheduleSettle();
      },
      { passive: false },
    );
  }

  /**
   * Centre frame `i`. Every deliberate move — arrow keys, the ← → buttons,
   * clicking a side frame, the lightbox — goes through here, so they cannot
   * disagree with each other or with a gesture still settling.
   */
  function goTo(i: number, smooth = true) {
    touched = true;
    clearTimeout(settleT);
    glideTo(i, smooth);
  }

  /** Clicking the centre frame opens the lightbox; a side frame centres it. */
  function frameClick(i: number, el: HTMLElement, e: Event) {
    e.preventDefault();
    if (i === gi) return openLightbox(i, el);
    goTo(i);
  }

  /** Move the row by ±1, wrapping. The lightbox does its own stepping when open. */
  function step(d: number, e?: Event) {
    if (e) {
      e.preventDefault?.();
      e.stopPropagation?.();
    }
    const n = reelLen;
    goTo((Math.min(gi, n - 1) + d + n) % n);
  }

  // Stepping inside the lightbox moves this page's current frame with it, so
  // closing it leaves the row centred on whatever was last looked at.
  onFrameChange((i) => goTo(i, false));

  window.addEventListener("keydown", (e) => {
    if (isOpen()) return; // the lightbox owns the keyboard while it is up
    if (e.key === "ArrowRight") return step(1, e);
    if (e.key === "ArrowLeft") return step(-1, e);
    if (e.key === "Enter") {
      e.preventDefault();
      openLightbox(gi, null);
    }
  });

  reelEl?.addEventListener("click", (e) => {
    const fig = (e.target as HTMLElement).closest<HTMLElement>("[data-reel-item]");
    if (!fig) return;
    const i = Number(fig.dataset.index);
    const img = fig.querySelector<HTMLElement>("img");
    frameClick(i, img ?? fig, e);
  });

  document.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((btn) => {
    btn.addEventListener("click", (e) => step(Number(btn.dataset.step), e));
  });

  bindReel();

  // Centre and reveal synchronously. Deliberately *not* inside
  // `requestAnimationFrame`: rAF does not run in a background tab, and the row
  // is held invisible until this line, so a page opened in a background tab
  // stayed blank until it was focused. This module is deferred, so the document
  // is parsed by now and `getBoundingClientRect()` forces the layout it needs.
  glideTo(0, false);
  paintReel();
  paintBar();
  reelEl?.removeAttribute("data-hold");

  /**
   * The row's geometry lands over time — thirteen of the sixteen frames are
   * lazy, and each one that arrives can nudge the widths by a pixel or two.
   * That is enough to leave the centre frame visibly off centre and keep it
   * there, so re-measure and re-centre as they come in.
   *
   * Only while the reader has not taken hold: re-centring under a hand that is
   * mid-gesture would be its own bug. `remeasure` still runs either way, since
   * a stale `bounds` is what makes the escape hatch at the ends misfire.
   */
  function resettle() {
    remeasure();
    if (!touched && !anim) glideTo(gi, false);
    paintReel();
  }

  window.addEventListener("load", resettle);
  reelEl?.querySelectorAll("img").forEach((im) => {
    im.addEventListener("load", resettle, { once: true });
  });

  // A resize changes every frame's width — the row is 58vh tall and the images
  // are height-driven — so whatever the reader was looking at drifts off
  // centre. Put it back once the resizing has stopped; doing it live would
  // fight a window drag. Unlike `resettle` this ignores `touched`: after a
  // resize, re-centring the frame they are on is the point.
  let resizeT = 0;
  window.addEventListener("resize", () => {
    remeasure();
    clearTimeout(resizeT);
    resizeT = window.setTimeout(() => {
      // Unconditionally, and cancelling any settle still pending: a landing in
      // flight was aimed at the geometry that existed before the resize, so it
      // is stale by definition. Guarding this on `!anim` instead let the two
      // race — the settle would win and the row would stay off centre.
      clearTimeout(settleT);
      glideTo(gi, false);
      paintReel();
    }, 120);
  });
</script>
