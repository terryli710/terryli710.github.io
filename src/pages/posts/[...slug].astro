---
// src/pages/posts/[...slug].astro — the reading room. One static path per
// (non-draft) `posts` collection entry, rendered through PostLayout.
//
// Posts run newest → oldest, and prev/next are a post's neighbours in that run.
import { getCollection } from "astro:content";
import PostLayout from "../../layouts/PostLayout.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: {
      post,
      // The run is newest → oldest, so "previous" is the older neighbour.
      prev: posts[i + 1],
      next: posts[i - 1],
    },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await post.render();

// Right-side TOC: body sections only. remark-gfm's auto-generated "Footnotes"
// heading is not an authored section, so it is excluded.
const toc = headings.filter(
  (h) => (h.depth === 2 || h.depth === 3) && h.slug !== "footnote-label",
);
---

<PostLayout post={post} prev={prev} next={next} toc={toc}>
  <Content />
</PostLayout>
